import lush/io;
import lush/int;

fn tri(a: Int, b: Int, c: Int) -> Int {
  a * 100 + b * 10 + c;
}

fn sub(from a: Int, take b: Int) -> Int {
  a - b;
}

pub type P {
  P(x: Int, y: Int)
}

pub fn main() -> Nil {
  io.println(int.to_string(tri(c: 3, a: 1, b: 2)));
  io.println(int.to_string(tri(1, c: 3, b: 2)));
  io.println(int.to_string(tri(b: 2, c: 3, a: 1)));
  io.println(int.to_string(sub(take: 3, from: 10)));
  let p = P(y: 2, x: 1);
  case p {
    P(x, y) -> io.println(int.to_string(x * 10 + y));
  };
}
