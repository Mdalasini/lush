import lush/io;
import lush/int;

pub fn body_len(bits) {
  case bits {
    <<n, body:bytes-size(n), rest:bytes>> -> {
      case body {
        <<a, b>> -> a + b;
        <<a>> -> a;
        _ -> 0;
      };
    };
    _ -> -1;
  };
}

pub fn dyn_int(bits, w) {
  case bits {
    <<x:size(w)>> -> x;
    _ -> -1;
  };
}

pub fn sized_bits(bits) {
  case bits {
    <<head:bits-size(4), tail:bits>> -> {
      case head {
        <<n:size(4)>> -> n;
        _ -> -2;
      };
    };
    _ -> -1;
  };
}

pub fn main() {
  // n=2, body=<<10, 20>>, rest=<<30>>
  io.println(int.to_string(body_len(<<2, 10, 20, 30>>)));
  // n=1, body=<<7>>, rest empty
  io.println(int.to_string(body_len(<<1, 7>>)));
  // wrong length for body → nomatch
  io.println(int.to_string(body_len(<<3, 1, 2>>)));
  // dynamic int width from outer binding
  io.println(int.to_string(dyn_int(<<255>>, 8)));
  io.println(int.to_string(dyn_int(<<1:size(4)>>, 4)));
  // sized bits then remainder
  io.println(int.to_string(sized_bits(<<0xF0>>)));
  Nil;
}
